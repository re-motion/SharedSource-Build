<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Remotion.BuildScript</RootNamespace>
    <AssemblyName>Remotion.BuildScript.Nuke</AssemblyName>
    <NoWarn>CS0649</NoWarn>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>true</WarningsAsErrors>
  </PropertyGroup>

  <Import Project="..\Shared.build.props" />

  <ItemGroup>
    <None Include="..\license\Apache-2.0.licenseheader" Link="Apache-2.0.licenseheader"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CycloneDX.Utils" Version="8.0.3" />
    <PackageReference Include="Fallout.Build" Version="10.5.0" />
    <PackageReference Include="Fallout.Common" Version="10.5.0" />
    <!-- Nuke 10.1.0 brings in NuGet.* 6.12.1. The copies in the build output win over the NuGet assemblies of the
         .NET SDK that MSBuild project evaluation (Nuke.ProjectModel) needs, so they must be at least as new as the SDK's. -->
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
    <PackageReference Include="Remotion.Infrastructure.SbomCleaner.Library" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BuildScript.Nuke.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CycloneDX" Version="4.0.0" ExcludeAssets="all" />
  </ItemGroup>

</Project>